  "paragraphs": [
    [
      "Seit einem Jahr wohne ich in einem Studentenwohnheim.",
      "Mein Zimmer ist klein und die Küche teile ich mit zehn anderen Studenten.",
      "Ich wollte endlich eine eigene Wohnung oder ein Zimmer in einer WG."
    ],
    [
      "Drei Wochen lang habe ich jeden Abend im Internet gesucht.",
      "Die meisten Wohnungen waren zu teuer oder zu weit von der Universität entfernt.",
      "Einmal bin ich zu einer Besichtigung gefahren, aber das Zimmer war dunkel und die Miete war zu hoch."
    ],
    [
      "Dann hat mir Lena geholfen.",
      "Sie hat erzählt, dass in ihrer Straße ein Zimmer frei wird.",
      "Eine Freundin von ihr zieht nach Berlin, weil sie dort eine neue Stelle gefunden hat."
    ],
    [
      "Ich habe sofort eine E-Mail an die Hauptmieterin geschrieben.",
      "Sie heißt Frau Weber und hat mich zu einer Besichtigung eingeladen.",
      "Am Samstag bin ich mit dem Fahrrad zur Wohnung gefahren."
    ],
    [
      "Das Zimmer war heller und größer als mein Zimmer im Wohnheim.",
      "Es hat einen Schreibtisch, ein Bett und einen großen Schrank.",
      "Die Miete kostet dreihundertachtzig Euro warm, also mit Strom und Heizung."
    ],
    [
      "Die anderen Mitbewohner waren sehr nett.",
      "Sie haben mich gefragt, warum ich umziehen möchte und ob ich oft koche.",
      "Ich habe gesagt, dass ich gern koche und abends meistens ruhig bin."
    ],
    [
      "Zwei Tage später hat Frau Weber angerufen.",
      "Sie hat gesagt: \"Sie können das Zimmer haben, wenn Sie noch Interesse haben.\"",
      "Ich habe mich sehr gefreut und sofort zugesagt."
    ],
    [
      "Letzte Woche habe ich den Mietvertrag unterschrieben.",
      "Am Ende des Monats bin ich umgezogen.",
      "Jetzt wohne ich näher an der Universität und kann jeden Morgen zu Fuß zur Vorlesung gehen."
    ]
  ],
