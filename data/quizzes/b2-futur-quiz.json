    {"id": "r3", "type": "typing", "prompt": "German for \"to predict\" (infinitive, separable):", "acceptedAnswers": ["voraussagen"]},
    {"id": "r4", "type": "typing", "prompt": "German for \"to announce\" (infinitive, separable):", "acceptedAnswers": ["ankündigen"]},
