    {"id": "p4", "type": "multiple-choice", "prompt": "\"wohl\" (with Futur I/II) signals:", "choices": ["an assumption, not a genuine future statement", "a strong denial", "a polite request", "a firm promise"], "correctIndex": 0},
    {"id": "p5", "type": "multiple-choice", "prompt": "\"wahrscheinlich\" means:", "choices": ["probably, likely", "certainly", "rarely", "never"], "correctIndex": 0},
